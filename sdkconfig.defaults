# Target: ESP32-WROOM-32E (classic BT + WiFi STA)
CONFIG_IDF_TARGET="esp32"

# 4MB module; project partitions.csv (~1.5MB factory) for Bluedroid + WiFi
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# CONFIG_PARTITION_TABLE_SINGLE_APP is not set
# CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE is not set

# Bluetooth classic + Bluedroid
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=n
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_SDP_COMMON_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

# WiFi
CONFIG_ESP_WIFI_ENABLED=y

# FreeRTOS / console logging
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Wireless Helper defaults (override via menuconfig)
CONFIG_AA_BT_DEVICE_NAME="ESP32 Wireless Helper"
CONFIG_AA_WIFI_SSID="AndroidAuto"
CONFIG_AA_WIFI_KEY="password123"
CONFIG_AA_TCP_PORT=5288
CONFIG_AA_KNOCK_PORT=5289
CONFIG_AA_WAKE_HOLD_MS=15000
